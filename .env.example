# ── Server ──────────────────────────────────────────────────────────────
PORT=3000
# LAN IP used when serving the backend to physical devices on your network.
LOCAL_IP=192.168.100.238
# Public base URL for WiPay response redirects.
# In production this should be your deployed Render/Railway URL,
# e.g. https://nood-backend.onrender.com
BACKEND_BASE_URL=http://192.168.100.238:3000

# ── WiPay payment gateway ───────────────────────────────────────────────
# Get this from your WiPay merchant dashboard. REQUIRED for checkout.
WIPAY_ACCOUNT_NUMBER=your_wipay_account_number
# Separate server-only WAPI keys (retrieve + refund-request scopes).
WIPAY_WAPI_KEY=
WIPAY_WAPI_SANDBOX_KEY=
WIPAY_WEBHOOK_SECRET=
WIPAY_SANDBOX_WEBHOOK_SECRET=
# sandbox | production
WIPAY_ENVIRONMENT=sandbox

# ── Shopify Admin API ───────────────────────────────────────────────────
# Your store domain, e.g. noodcaribbean.myshopify.com (no https://)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Admin API access token (created in Shopify Admin → Settings → Apps →
# Develop apps → Admin API access token). REQUIRED for order creation.
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_access_token
# Admin API version — keep in sync with the Storefront API version used by
# the app (see EXPO_PUBLIC_SHOPIFY_API_VERSION in nood-app/.env).
SHOPIFY_ADMIN_API_VERSION=2026-04
# Storefront API token — used as a FALLBACK for inventory/new-product sync
# when the Admin API returns 402 (plan limitation / unpaid invoice). Works
# on every Shopify plan. Same value the app uses.
SHOPIFY_STOREFRONT_TOKEN=your_shopify_storefront_token

# ── Shopify Webhooks ────────────────────────────────────────────────────
# Secret for verifying Shopify webhook signatures (from Shopify Admin →
# Settings → Notifications → Webhooks → "Add webhook" → secret)
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Supabase (PostgreSQL) ───────────────────────────────────────────────
# For cart recovery, inventory sync, order sync, etc.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Push notifications ──────────────────────────────────────────────────
# Admin token protecting /api/notifications/send + /campaign + /deactivate-token.
# MUST be set to a long random string (>=16 chars) in production. Endpoints
# return 503 when unset (fail closed).
NOOD_ADMIN_TOKEN=your_admin_token_here

# Frequency / anti-spam (all optional — defaults in parentheses):
# Minimum minutes between promotional pushes to the same device (60)
PUSH_MIN_INTERVAL_MINUTES=60
# Max promotional pushes per device per day (3)
PUSH_MAX_PROMO_PER_DAY=3
# Quiet hours (server local time, 0-23) — promotional pushes suppressed (22-8)
PUSH_QUIET_HOURS_ENABLED=true
PUSH_QUIET_HOURS_START=22
PUSH_QUIET_HOURS_END=8
# Campaign engine interval (15)
PUSH_CAMPAIGN_INTERVAL_MINUTES=15
# New-product batching: >= N new products in one sync → single batch push (3)
PUSH_NEW_PRODUCT_BATCH_THRESHOLD=3
# Cart nudge cooldown between nudges for the same cart, hours (48)
PUSH_CART_NUDGE_COOLDOWN_HOURS=48
# Cart must be untouched for at least this long before a nudge, minutes (60)
PUSH_CART_NUDGE_MIN_AGE_MINUTES=60
# Hour (0-23, server local) when the daily-reward reminder fires (18)
PUSH_REWARD_REMINDER_HOUR=18
# Flash-sale window for the daily flash-live push (6-10)
PUSH_FLASH_WINDOW_START=6
PUSH_FLASH_WINDOW_END=10

# ── SendGrid Email ──────────────────────────────────────────────────────
# For cart abandonment, order confirmation, shipping notifications, etc.
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@noodcaribbean.com
FROM_NAME=NOOD

# ── Frontend URL ────────────────────────────────────────────────────────
# Used in email templates for deep links back to the app
FRONTEND_URL=https://noodcaribbean.com
